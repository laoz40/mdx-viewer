#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
VIEWER_ROOT="${MDXV_ROOT:-$(cd "$script_dir/.." && pwd)}"

usage() {
  cat <<'EOF'
Usage: mdxv [options] <folder|file.mdx>

Build and view an MDX document with the global mdx-planner viewer.

Modes:
  (default)       Build a self-contained HTML file and open it in a browser
  --port PORT     Build and serve on localhost (for Tailscale Serve)
  --serve         Build and serve on all interfaces (direct bind)

Options:
  -p, --port PORT  Localhost server port (with --port) or bind port (with --serve)
  --no-open        Do not open a browser tab

Flags may appear before or after the document path.

Examples:
  mdxv docs/guide.mdx
  mdxv --no-open plans/auth-refactor/plan.mdx
  mdxv --port 5199 docs/guide.mdx
  mdxv --serve -p 5200 example/example.mdx

Environment:
  MDXV_ROOT        Viewer checkout (default: parent of this script's directory)
  MDXV_PORT        Default port for --serve when -p is not set
  MDXV_OPEN        Override open behavior when --no-open is not set
EOF
}

resolve_mdx_file() {
  local target="$1"

  if [[ -f "$target" && "$target" == *.mdx ]]; then
    realpath "$target"
    return 0
  fi

  if [[ -d "$target" ]]; then
    local folder_name
    folder_name="$(basename "$target")"

    if [[ -f "$target/plan.mdx" ]]; then
      realpath "$target/plan.mdx"
      return 0
    fi

    if [[ -f "$target/${folder_name}.mdx" ]]; then
      realpath "$target/${folder_name}.mdx"
      return 0
    fi
  fi

  echo "error: expected a .mdx file or a folder containing plan.mdx or <folder>.mdx: $target" >&2
  exit 1
}

validate_port() {
  local value="$1"
  if ! [[ "$value" =~ ^[0-9]+$ ]] || (( value < 1 || value > 65535 )); then
    echo "error: invalid port: $value" >&2
    exit 1
  fi
}

mode="default"
mdx_target=""
port=""
port_flag=0
no_open=0

while [[ $# -gt 0 ]]; do
  case "$1" in
    -h|--help)
      usage
      exit 0
      ;;
    --serve)
      if [[ "$mode" == "listen" ]]; then
        echo "error: use only one of --port or --serve" >&2
        exit 1
      fi
      mode="serve"
      shift
      ;;
    -p|--port)
      if [[ -z "${2:-}" ]]; then
        echo "error: --port requires a value" >&2
        exit 1
      fi
      if [[ "$mode" == "serve" ]]; then
        port="$2"
        port_flag=1
        shift 2
        continue
      fi
      if [[ "$mode" != "default" ]]; then
        echo "error: --port specified more than once" >&2
        exit 1
      fi
      mode="listen"
      port="$2"
      port_flag=1
      shift 2
      ;;
    --port=*)
      if [[ "$mode" == "serve" ]]; then
        port="${1#*=}"
        port_flag=1
        shift
        continue
      fi
      if [[ "$mode" != "default" ]]; then
        echo "error: --port specified more than once" >&2
        exit 1
      fi
      mode="listen"
      port="${1#*=}"
      port_flag=1
      shift
      ;;
    --no-open)
      no_open=1
      shift
      ;;
    -*)
      echo "error: unknown option: $1" >&2
      usage >&2
      exit 1
      ;;
    *)
      if [[ -n "$mdx_target" ]]; then
        echo "error: unexpected argument: $1" >&2
        exit 1
      fi
      mdx_target="$1"
      shift
      ;;
  esac
done

if [[ -z "$mdx_target" ]]; then
  usage
  exit 1
fi

if [[ ! -d "$VIEWER_ROOT" ]]; then
  echo "error: viewer not found at $VIEWER_ROOT" >&2
  echo "set MDXV_ROOT to your mdx-planner checkout" >&2
  exit 1
fi

mdx_file="$(resolve_mdx_file "$mdx_target")"
export MDXV_FILE="$mdx_file"
export MDXV_MODE="$mode"
export MDXV_PORT="${port:-${MDXV_PORT:-5199}}"
validate_port "$MDXV_PORT"

case "$mode" in
  default)
    export MDXV_HOST="127.0.0.1"
    if [[ "$no_open" == 1 ]]; then
      export MDXV_OPEN=0
    else
      export MDXV_OPEN="${MDXV_OPEN:-1}"
    fi
    ;;
  listen)
    export MDXV_HOST="127.0.0.1"
    if [[ "$no_open" == 1 ]]; then
      export MDXV_OPEN=0
    else
      export MDXV_OPEN="${MDXV_OPEN:-0}"
    fi
    ;;
  serve)
    export MDXV_HOST="0.0.0.0"
    if [[ "$no_open" == 1 ]]; then
      export MDXV_OPEN=0
    else
      export MDXV_OPEN="${MDXV_OPEN:-0}"
    fi
    ;;
esac

cd "$VIEWER_ROOT"

if [[ ! -d node_modules ]]; then
  echo "installing viewer dependencies..."
  pnpm install
fi

exec pnpm dev
