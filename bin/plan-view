#!/usr/bin/env bash
set -euo pipefail

script_dir="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
VIEWER_ROOT="${PLAN_VIEWER_ROOT:-$(cd "$script_dir/.." && pwd)}"

usage() {
  cat <<'EOF'
Usage: plan-view <plan-folder|plan.mdx>

Opens a local MDX plan in the global plan viewer (Vite dev server).

Examples:
  plan-view plans/auth-refactor
  plan-view plans/auth-refactor/plan.mdx

Environment:
  PLAN_VIEWER_ROOT   Viewer checkout (default: parent of this script's directory)
  PLAN_PORT          Dev server port (default: 5199)
  PLAN_OPEN=0        Skip opening a browser tab
EOF
}

resolve_plan_file() {
  local target="$1"

  if [[ -f "$target" && "$target" == *.mdx ]]; then
    realpath "$target"
    return 0
  fi

  if [[ -d "$target" && -f "$target/plan.mdx" ]]; then
    realpath "$target/plan.mdx"
    return 0
  fi

  echo "error: expected a plan folder with plan.mdx or a .mdx file: $target" >&2
  exit 1
}

case "${1:-}" in
  -h|--help|'')
    usage
    [[ -n "${1:-}" ]] || exit 1
    ;;
esac

if [[ ! -d "$VIEWER_ROOT" ]]; then
  echo "error: plan viewer not found at $VIEWER_ROOT" >&2
  echo "set PLAN_VIEWER_ROOT to your plan-viewer checkout" >&2
  exit 1
fi

plan_file="$(resolve_plan_file "$1")"
export PLAN_FILE="$plan_file"
export PLAN_OPEN="${PLAN_OPEN:-1}"
export PLAN_PORT="${PLAN_PORT:-5199}"

cd "$VIEWER_ROOT"

if [[ ! -d node_modules ]]; then
  echo "installing plan-viewer dependencies..."
  pnpm install
fi

echo "plan: $plan_file"
echo "viewer: $VIEWER_ROOT"
echo "url: http://localhost:${PLAN_PORT}"

exec pnpm dev
