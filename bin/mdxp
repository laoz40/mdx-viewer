#!/usr/bin/env bash
set -euo pipefail

script_path="$(readlink -f "${BASH_SOURCE[0]}")"
script_dir="$(cd "$(dirname "$script_path")" && pwd)"
PLANNER_ROOT="${MDX_PLANNER_ROOT:-$(cd "$script_dir/.." && pwd)}"

usage() {
  cat <<'EOF'
Usage: mdxp <plan-folder|plan.mdx>

Opens a local MDX plan in the global mdx-planner viewer.

Examples:
  mdxp plans/auth-refactor
  mdxp plans/auth-refactor/plan.mdx

Environment:
  MDX_PLANNER_ROOT   Viewer checkout (default: parent of this script's directory)
  PLAN_PORT          Server port (default: 5199)
  PLAN_HOST          Bind address (default: 127.0.0.1)
  PLAN_OPEN=0        Skip opening a browser tab
EOF
}

resolve_plan_file() {
  local target="$1"

  if [[ -f "$target" && "$target" == *.mdx ]]; then
    realpath "$target"
    return 0
  fi

  if [[ -d "$target" && -f "$target/plan.mdx" ]]; then
    realpath "$target/plan.mdx"
    return 0
  fi

  echo "error: expected a plan folder with plan.mdx or a .mdx file: $target" >&2
  exit 1
}

case "${1:-}" in
  -h|--help|'')
    usage
    [[ -n "${1:-}" ]] || exit 1
    ;;
esac

if [[ ! -d "$PLANNER_ROOT" ]]; then
  echo "error: mdx-planner not found at $PLANNER_ROOT" >&2
  echo "set MDX_PLANNER_ROOT to your mdx-planner checkout" >&2
  exit 1
fi

plan_file="$(resolve_plan_file "$1")"
export PLAN_FILE="$plan_file"
export PLAN_OPEN="${PLAN_OPEN:-1}"
export PLAN_PORT="${PLAN_PORT:-5199}"

cd "$PLANNER_ROOT"

if [[ ! -d node_modules ]]; then
  echo "installing mdx-planner dependencies..."
  pnpm install
fi

echo "plan: $plan_file"
echo "viewer: $PLANNER_ROOT"
echo "url: http://localhost:${PLAN_PORT}"

exec pnpm dev
